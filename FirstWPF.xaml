<UserControl x:Class="CivNonDev.FirstWPF"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CivNonDev"
             mc:Ignorable="d" d:DesignWidth="800" Height="500">
    <Grid Background ="Beige">
        <TextBlock x:Name="textBlock1" HorizontalAlignment="Left" Margin="100,50,0,0" TextWrapping="Wrap" Text="선형 Excel 파일 선택" VerticalAlignment="Top"/>
        <TextBlock x:Name="textBlock2" HorizontalAlignment="Left" Margin="100,100,0,0" TextWrapping="Wrap" Text="선형 이름(시트명)" VerticalAlignment="Top"/>
        <TextBlock x:Name="textBlock3" HorizontalAlignment="Left" Margin="100,150,0,0" TextWrapping="Wrap" Text="구조물 시작 Sta." VerticalAlignment="Top"/>
        <TextBlock x:Name="textBlock4" HorizontalAlignment="Left" Margin="100,200,0,0" TextWrapping="Wrap" Text="구조물 끝 Sta." VerticalAlignment="Top"/>
        <TextBlock x:Name="textBlock5" HorizontalAlignment="Left" Margin="100,250,0,0" TextWrapping="Wrap" Text="구간 분할 개수" VerticalAlignment="Top"/>
        <TextBlock x:Name="textBlock6" HorizontalAlignment="Left" Margin="100,300,0,0" TextWrapping="Wrap" Text="터널 유형 선택" VerticalAlignment="Top"/>
        <Button Content="Open Excel" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="250,0,0,427" Width="100" Height="30" Click="OpenExcelFile_Click"/>
        <ComboBox Name="AdaptiveFamilyComboBox" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="250,97,0,0" Width="200"/>
        <TextBox x:Name="textBox1" HorizontalAlignment="Left" Margin="250,150,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" TextChanged="textBox_TextChanged"/>
        <TextBox x:Name="textBox2" HorizontalAlignment="Left" Margin="250,200,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" TextChanged="textBox_TextChanged"/>
        <TextBox x:Name="textBox3" HorizontalAlignment="Left" Margin="250,250,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" TextChanged="textBox_TextChanged"/>
        <ComboBox Name="TypeSelectComboBox" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="250,300,0,0" Width="200"/>
        <Button Content="생성" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,446,0,0" Width="100" Click="SubmitButton_Click"/>
    </Grid>
</UserControl>
